# Polling. Checks begin on a fixed cycle: 0s, 60s, 120s, ...
CHECK_SECONDS=60
MAX_CONCURRENCY=4
HEADLESS=true
SCREENSHOT_ON_ERROR=false
DB_PATH=/data/watcher.db
PORT=8080

# Email alert settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
ALERT_TO=your_email@gmail.com
